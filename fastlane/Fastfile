default_platform(:ios)
opt_out_usage

platform :ios do
  project = "iosApp/iosApp.xcodeproj"
  scheme = "iosApp"

  testflight_description = <<~TEXT.strip
    ToriNos は分散型SNSの投稿閲覧、投稿、プロフィール表示、チャンネル閲覧を行うためのクライアントアプリです。
    このベータ版では、タイムライン表示、投稿作成、返信、プロフィール確認、リレー設定、ミュート・NG ワード設定などの基本動作を確認します。
  TEXT

  what_to_test = <<~TEXT.strip
    次の操作を中心に確認してください。
    - タイムラインの表示と更新
    - 投稿、返信、スレッド表示
    - プロフィール表示とフォロー一覧
    - チャンネル一覧とチャンネル内投稿
    - リレー設定、ミュート、NG ワード、カスタム絵文字設定
    - アカウント追加、切り替え、ログアウト

    不具合を見つけた場合は、発生した画面、操作手順、スクリーンショットを TestFlight のフィードバックから送信してください。
  TEXT

  review_notes = <<~TEXT.strip
    このアプリは分散型SNS向けクライアントです。
    ログインしなくても公開タイムラインなど一部機能を確認できます。
    投稿、返信、プロフィール編集などの書き込み機能を確認する場合は、アプリ内の鍵作成または既存の秘密鍵のインポートを使用してください。
    登録またはログイン前に EULA/利用条件への同意画面を表示します。
    投稿メニューから不適切な投稿を通報できます。通報時は NIP-56 レポートを送信し、対象ユーザーをブロックしてフィードから直ちに非表示にします。
    投稿メニューまたはプロフィール画面からユーザーをブロックできます。NG ワード設定で不適切または見たくない語句を含む投稿をフィルタできます。
    審査用の固定デモアカウントは不要です。
  TEXT

  private_lane :app_store_connect_api_key_from_env do
    key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"]
    key_filepath = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
    configured_values = [key_id, issuer_id, key_filepath].compact.reject(&:empty?)

    next nil if configured_values.empty?

    if configured_values.length != 3
      UI.user_error!(
        "App Store Connect APIキーを使う場合は " \
        "APP_STORE_CONNECT_API_KEY_KEY_ID、" \
        "APP_STORE_CONNECT_API_KEY_ISSUER_ID、" \
        "APP_STORE_CONNECT_API_KEY_KEY_FILEPATH をすべて設定してください。"
      )
    end

    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )
  end

  desc "Build the iOS app and upload it to TestFlight"
  lane :release do |options|
    ensure_git_status_clean unless options[:allow_dirty]

    build_app(
      project: project,
      scheme: scheme,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "automatic",
        teamID: "2F7KXC2828"
      },
      xcargs: "-allowProvisioningUpdates",
      export_xcargs: "-allowProvisioningUpdates",
      output_directory: "build/ios/release",
      output_name: "ToriNos.ipa"
    )

    archive_path = lane_context[SharedValues::XCODEBUILD_ARCHIVE]
    UI.user_error!("作成したXcodeアーカイブを取得できませんでした。") unless archive_path

    sh(
      "xcodebuild",
      "-exportArchive",
      "-archivePath", archive_path,
      "-exportPath", File.expand_path("../build/ios/upload", __dir__),
      "-exportOptionsPlist", File.expand_path("ExportOptions.plist", __dir__),
      "-allowProvisioningUpdates"
    )
  end

  desc "Upload TestFlight metadata and optionally distribute to external testers"
  lane :testflight_info do |options|
    feedback_email = ENV["TESTFLIGHT_FEEDBACK_EMAIL"]
    contact_first_name = ENV["TESTFLIGHT_CONTACT_FIRST_NAME"]
    contact_last_name = ENV["TESTFLIGHT_CONTACT_LAST_NAME"]
    contact_phone = ENV["TESTFLIGHT_CONTACT_PHONE"]

    upload_options = {
      app_identifier: "com.nostr.torinos.app",
      username: ENV["APP_STORE_CONNECT_USERNAME"] || ENV["FASTLANE_USER"],
      skip_waiting_for_build_processing: false,
      skip_submission: options[:skip_submission] != false,
      beta_app_description: options[:description] || testflight_description,
      changelog: options[:what_to_test] || what_to_test
    }

    api_key = app_store_connect_api_key_from_env
    upload_options[:api_key] = api_key if api_key
    upload_options.delete(:username) unless upload_options[:username]

    upload_options[:beta_app_feedback_email] = feedback_email if feedback_email

    if feedback_email && contact_first_name && contact_last_name && contact_phone
      upload_options[:beta_app_review_info] = {
        contact_first_name: contact_first_name,
        contact_last_name: contact_last_name,
        contact_email: feedback_email,
        contact_phone: contact_phone,
        demo_account_required: false,
        notes: options[:review_notes] || review_notes
      }
    end

    upload_to_testflight(upload_options)
  end

  desc "Update TestFlight metadata for an already uploaded build"
  lane :testflight_metadata do |options|
    feedback_email = ENV["TESTFLIGHT_FEEDBACK_EMAIL"]
    contact_first_name = ENV["TESTFLIGHT_CONTACT_FIRST_NAME"]
    contact_last_name = ENV["TESTFLIGHT_CONTACT_LAST_NAME"]
    contact_phone = ENV["TESTFLIGHT_CONTACT_PHONE"]

    metadata_options = {
      app_identifier: "com.nostr.torinos.app",
      username: ENV["APP_STORE_CONNECT_USERNAME"] || ENV["FASTLANE_USER"],
      distribute_only: true,
      skip_submission: true,
      app_version: options[:app_version] || "1.0",
      build_number: options[:build_number] || "1",
      beta_app_description: options[:description] || testflight_description,
      changelog: options[:what_to_test] || what_to_test
    }

    api_key = app_store_connect_api_key_from_env
    metadata_options[:api_key] = api_key if api_key
    metadata_options.delete(:username) unless metadata_options[:username]
    metadata_options[:beta_app_feedback_email] = feedback_email if feedback_email

    if feedback_email && contact_first_name && contact_last_name && contact_phone
      metadata_options[:beta_app_review_info] = {
        contact_first_name: contact_first_name,
        contact_last_name: contact_last_name,
        contact_email: feedback_email,
        contact_phone: contact_phone,
        demo_account_required: false,
        notes: options[:review_notes] || review_notes
      }
    end

    upload_to_testflight(metadata_options)
  end
end

platform :android do
  package_name = "com.nostr.torinos"
  aab_path = "androidApp/build/outputs/bundle/release/androidApp-release.aab"

  private_lane :play_json_key_path do
    path = File.expand_path(
      ENV["SUPPLY_JSON_KEY"].to_s.empty? ? "~/.config/torinos/nostr-torinos-f9eafe2256a8.json" : ENV["SUPPLY_JSON_KEY"]
    )
    UI.user_error!("Google Play のサービスアカウント鍵が見つかりません: #{path}（SUPPLY_JSON_KEY で場所を指定できます）") unless File.exist?(path)
    path
  end

  desc "Check that the Google Play service account key can reach the Play Console"
  lane :validate_play_key do
    validate_play_store_json_key(json_key: play_json_key_path)
  end

  desc "Build the signed Android bundle and upload it to Google Play"
  desc "Release notes are read from fastlane/metadata/android/<locale>/changelogs/<versionCode>.txt"
  lane :release do |options|
    ensure_git_status_clean unless options[:allow_dirty]

    json_key = play_json_key_path

    gradle(task: ":androidApp:bundleRelease") unless options[:skip_build]

    upload_to_play_store(
      package_name: package_name,
      json_key: json_key,
      aab: File.expand_path("../#{aab_path}", __dir__),
      # The gradle step picks up leftover APKs from earlier builds; only the bundle should go up.
      skip_upload_apk: true,
      track: options[:track] || "production",
      # Upload as a draft by default so the release is reviewed in Play Console before it goes out.
      release_status: options[:release_status] || "draft",
      validate_only: options[:validate_only] == true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
