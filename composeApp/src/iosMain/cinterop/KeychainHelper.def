language = Objective-C
headers =
linkerOpts = -framework Security -framework Foundation

---
#import <Security/Security.h>
#import <Foundation/Foundation.h>

/**
 * ObjC ARC wrappers that use (__bridge CFDictionaryRef) to toll-free bridge
 * an NSDictionary to CFDictionaryRef for Security framework calls.
 *
 * Using `id` for the dict parameter so Kotlin/Native maps it to `Any?` and
 * avoids the NSDictionary/Map<Any?,*> type-variance mismatch.
 */

static OSStatus KeychainCopyMatching(id _Nonnull query,
                                     CFTypeRef _Nullable * _Nullable result) {
    return SecItemCopyMatching((__bridge CFDictionaryRef)query, result);
}

static NSMutableDictionary * _Nonnull KeychainBaseQuery(NSString * _Nonnull service,
                                                        NSString * _Nonnull account,
                                                        BOOL includeSynchronizable,
                                                        BOOL synchronizable) {
    NSMutableDictionary *query = [@{
        (__bridge id)kSecClass: (__bridge id)kSecClassGenericPassword,
        (__bridge id)kSecAttrService: service,
        (__bridge id)kSecAttrAccount: account
    } mutableCopy];
    if (includeSynchronizable) {
        query[(__bridge id)kSecAttrSynchronizable] = synchronizable ? @YES : @NO;
    }
    return query;
}

static NSData * _Nullable KeychainCopyData(id _Nonnull query) {
    CFTypeRef result = NULL;
    OSStatus status = SecItemCopyMatching((__bridge CFDictionaryRef)query, &result);
    if (status != errSecSuccess || result == NULL) {
        return nil;
    }
    return (__bridge_transfer NSData *)result;
}

static NSData * _Nullable KeychainLoadData(NSString * _Nonnull service,
                                           NSString * _Nonnull account,
                                           BOOL includeSynchronizable,
                                           BOOL synchronizable) {
    NSMutableDictionary *query = KeychainBaseQuery(service, account, includeSynchronizable, synchronizable);
    query[(__bridge id)kSecMatchLimit] = (__bridge id)kSecMatchLimitOne;
    query[(__bridge id)kSecReturnData] = @YES;
    return KeychainCopyData(query);
}

static OSStatus KeychainItemDelete(id _Nonnull attrs) {
    return SecItemDelete((__bridge CFDictionaryRef)attrs);
}

static OSStatus KeychainItemAdd(id _Nonnull attrs) {
    return SecItemAdd((__bridge CFDictionaryRef)attrs, NULL);
}

static OSStatus KeychainDeleteData(NSString * _Nonnull service,
                                   NSString * _Nonnull account,
                                   BOOL includeSynchronizable,
                                   BOOL synchronizable) {
    NSMutableDictionary *query = KeychainBaseQuery(service, account, includeSynchronizable, synchronizable);
    return SecItemDelete((__bridge CFDictionaryRef)query);
}

static OSStatus KeychainSaveData(NSString * _Nonnull service,
                                 NSString * _Nonnull account,
                                 NSData * _Nonnull data) {
    KeychainDeleteData(service, account, NO, NO);
    KeychainDeleteData(service, account, YES, YES);

    NSMutableDictionary *attrs = KeychainBaseQuery(service, account, NO, NO);
    attrs[(__bridge id)kSecValueData] = data;
    attrs[(__bridge id)kSecAttrAccessible] = (__bridge id)kSecAttrAccessibleAfterFirstUnlockThisDeviceOnly;
    return SecItemAdd((__bridge CFDictionaryRef)attrs, NULL);
}

static OSStatus KeychainSaveSynchronizableData(NSString * _Nonnull service,
                                               NSString * _Nonnull account,
                                               NSData * _Nonnull data) {
    KeychainDeleteData(service, account, NO, NO);
    KeychainDeleteData(service, account, YES, YES);

    NSMutableDictionary *attrs = KeychainBaseQuery(service, account, YES, YES);
    attrs[(__bridge id)kSecValueData] = data;
    attrs[(__bridge id)kSecAttrAccessible] = (__bridge id)kSecAttrAccessibleAfterFirstUnlock;
    return SecItemAdd((__bridge CFDictionaryRef)attrs, NULL);
}

/**
 * kSecClassInternetPassword で iCloud Keychain に保存する。
 * iOS の「パスワード」アプリ（設定 > パスワード / iOS 18 の Passwords アプリ）に表示される。
 * server: ToriNos のサービス識別子（例: "nostr.torinos.app"）
 * account: npub（公開鍵）
 * data: nsec（秘密鍵）のバイト列
 */
static OSStatus KeychainSaveInternetPassword(NSString * _Nonnull server,
                                             NSString * _Nonnull account,
                                             NSData * _Nonnull data) {
    // 既存エントリを削除（synchronizable の有無を問わず）
    NSDictionary *deleteQuery = @{
        (__bridge id)kSecClass: (__bridge id)kSecClassInternetPassword,
        (__bridge id)kSecAttrServer: server,
        (__bridge id)kSecAttrAccount: account,
        (__bridge id)kSecAttrSynchronizable: (__bridge id)kSecAttrSynchronizableAny,
    };
    SecItemDelete((__bridge CFDictionaryRef)deleteQuery);

    NSDictionary *attrs = @{
        (__bridge id)kSecClass: (__bridge id)kSecClassInternetPassword,
        (__bridge id)kSecAttrServer: server,
        (__bridge id)kSecAttrAccount: account,
        (__bridge id)kSecValueData: data,
        (__bridge id)kSecAttrSynchronizable: @YES,
        (__bridge id)kSecAttrAccessible: (__bridge id)kSecAttrAccessibleAfterFirstUnlock,
    };
    return SecItemAdd((__bridge CFDictionaryRef)attrs, NULL);
}

/**
 * Associated Domains の webcredentials と組み合わせて、iOS Password AutoFill
 * で使える共有 Web 認証情報として保存を依頼する。
 */
static void KeychainAddSharedWebCredential(NSString * _Nonnull domain,
                                           NSString * _Nonnull account,
                                           NSString * _Nonnull password) {
    SecAddSharedWebCredential(
        (__bridge CFStringRef)domain,
        (__bridge CFStringRef)account,
        (__bridge CFStringRef)password,
        NULL
    );
}
